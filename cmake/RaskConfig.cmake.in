@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Qt6 6.10 COMPONENTS Core Gui Qml Quick QuickControls2 Svg QmlIntegration)

include("${CMAKE_CURRENT_LIST_DIR}/RaskTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/RaskApp.cmake")

# Sparkle is installed next to the libraries; rask_embed_libraries() copies it.
if(APPLE AND TARGET Rask::Updater)
    set_target_properties(Rask::Updater PROPERTIES
        RASK_EMBED_FRAMEWORKS "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/Sparkle.framework")
endif()

check_required_components(Rask)
